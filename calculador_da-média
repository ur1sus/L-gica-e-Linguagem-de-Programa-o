algoritmo "Calculador_de_Media"
var
  soma_notas: real
  qtd_notas: inteiro
  nota_digitada: real
  media_turma: real
inicio
soma_notas <- 0
qtd_notas: <- 0 
escreval ("Digite nota do aluno (ou -1 para calcular a média):")
leia (nota_digitada)
enquanto nota_digitada <> -1 faca
 soma_notas <- soma_notas + nota_digitada
 qtd_notas <- qtd_notas + 1
 leia 
