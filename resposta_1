algoritmo "Contagem_decrescente"

var 
  numero, i: inteiro
  contador: inteiro  

inicio 
para contador de 1 ate 5 faca
  escreval ("Digite um número inteiro positivo: ")
  leia (numero)
  escreval (" ") 
  para i de numero ate 1 passo -1 faca
  escreval (i," ")
  fimpara
fimpara

fimalgoritmo

    
